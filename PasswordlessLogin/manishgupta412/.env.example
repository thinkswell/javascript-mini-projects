# Mailtrap Email API — Transactional stream (Sending Domains → API Tokens)
MAILTRAP_TOKEN=your-mailtrap-api-token
# Must be an address on a domain verified in Mailtrap
MAIL_FROM_EMAIL=login@yourdomain.com
MAIL_FROM_NAME=Your App

# Public base URL used to build magic links. https:// enables Secure cookies.
APP_URL=http://localhost:3000
PORT=3000

# HMAC key for codes/tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OTP_SECRET=replace-with-a-long-random-string-at-least-32-chars

# false = only existing users (add with `npm run user:add -- you@example.com`)
# true  = create the user on first successful login
AUTO_SIGNUP=false

DATABASE_PATH=./data/app.db

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
